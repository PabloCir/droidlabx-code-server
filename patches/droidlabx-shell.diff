@@ -0,0 +1,61 @@
+/* DroidLabX: hide chrome a simple phone IDE does not need. */
+
+.monaco-workbench .command-center,
+.monaco-workbench .command-center-center {
+	display: none !important;
+}
+
+.monaco-workbench .codicon-comment-discussion,
+.monaco-workbench .codicon-copilot,
+.monaco-workbench .codicon-account {
+	display: none !important;
+}
+
+.monaco-workbench .activitybar .action-item[aria-label*="Chat" i],
+.monaco-workbench .activitybar .action-item[aria-label*="Accounts" i],
+.monaco-workbench .activitybar .action-item[aria-label*="Source Control" i],
+.monaco-workbench .activitybar .action-item[aria-label*="Remote Explorer" i],
+.monaco-workbench .activitybar .action-item[aria-label*="Ports" i],
+.monaco-workbench .activitybar .codicon-source-control-view-icon,
+.monaco-workbench .activitybar .codicon-remote-explorer-view-icon {
+	display: none !important;
+}
+
+.monaco-workbench .composite-bar .action-item[aria-label*="Source Control" i],
+.monaco-workbench .composite-bar .action-item[aria-label*="Remote Explorer" i],
+.monaco-workbench .composite-bar .action-item[aria-label*="Chat" i],
+.monaco-workbench .composite-bar .action-item[aria-label*="Ports" i] {
+	display: none !important;
+}
+
+.monaco-workbench .statusbar-item[id*="git"],
+.monaco-workbench .statusbar-item[id*="scm"],
+.monaco-workbench .statusbar-item[id="status.scm"],
+.monaco-workbench .statusbar-item[id*="status.remote"],
+.monaco-workbench .statusbar-item[id="status.host"] {
+	display: none !important;
+}
+
+.monaco-workbench.dlx-compact .dlx-drawer-toggle {
+	position: absolute;
+	top: 4px;
+	left: 4px;
+	z-index: 3000;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	width: 44px;
+	height: 44px;
+	margin: 0;
+	padding: 0;
+	border: 0;
+	border-radius: 8px;
+	background: var(--vscode-titleBar-activeBackground, var(--vscode-editor-background));
+	color: var(--vscode-titleBar-activeForeground, var(--vscode-foreground));
+	box-shadow: 0 0 0 1px var(--vscode-widget-border, transparent);
+	cursor: pointer;
+}
+
+.monaco-workbench.dlx-compact .dlx-drawer-toggle .codicon {
+	font-size: 20px;
+}
