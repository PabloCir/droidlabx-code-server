+
+import './media/droidlabxShell.css';
+import { localize, localize2 } from '../../../../nls.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { IWorkbenchContribution, WorkbenchPhase, registerWorkbenchContribution2 } from '../../../common/contributions.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { IContextKey, IContextKeyService, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import { ConfigurationTarget, IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { IWorkbenchLayoutService, Parts } from '../../../services/layout/browser/layoutService.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+
+/** Phone portrait / narrow webview. Tablet and desktop keep the side rail. */
+export const DLX_COMPACT_MAX_WIDTH = 768;
+
+export const DroidLabXCompactContext = new RawContextKey<boolean>('droidlabx.compact', false);
+
+const ACCOUNTS_VISIBILITY_KEY = 'workbench.activity.showAccounts';
+const TOGGLE_DRAWER_ID = 'droidlabx.toggleDrawer';
+
+function setDrawerHidden(layoutService: IWorkbenchLayoutService, hidden: boolean): void {
+	layoutService.setPartHidden(hidden, Parts.SIDEBAR_PART);
+	layoutService.setPartHidden(hidden, Parts.ACTIVITYBAR_PART);
+}
+
+export class DroidLabXShellContribution implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.droidlabxShell';
+
+	private readonly compactKey: IContextKey<boolean>;
+	private compact = false;
+	private applied = false;
+	private drawerButton: HTMLButtonElement | undefined;
+
+	constructor(
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IStorageService storageService: IStorageService,
+	) {
+		this.compactKey = DroidLabXCompactContext.bindTo(contextKeyService);
+
+		if (storageService.get(ACCOUNTS_VISIBILITY_KEY, StorageScope.PROFILE) === undefined) {
+			storageService.store(ACCOUNTS_VISIBILITY_KEY, false, StorageScope.PROFILE, StorageTarget.MACHINE);
+		}
+
+		this.apply(this.layoutService.mainContainerDimension.width);
+		this.layoutService.onDidLayoutMainContainer(dimension => this.apply(dimension.width));
+		this.editorService.onDidActiveEditorChange(() => {
+			if (this.compact && this.layoutService.isVisible(Parts.SIDEBAR_PART)) {
+				setDrawerHidden(this.layoutService, true);
+				this.syncDrawerButton();
+			}
+		});
+	}
+
+	private apply(width: number): void {
+		if (width < 200) {
+			return;
+		}
+		const compact = width < DLX_COMPACT_MAX_WIDTH;
+		if (!this.applied || compact !== this.compact) {
+			this.applied = true;
+			this.compact = compact;
+			this.compactKey.set(compact);
+			this.layoutService.mainContainer.classList.toggle('dlx-compact', compact);
+
+			if (compact) {
+				setDrawerHidden(this.layoutService, true);
+				this.layoutService.setPartHidden(true, Parts.PANEL_PART);
+				this.layoutService.setPartHidden(true, Parts.AUXILIARYBAR_PART);
+				void this.configurationService.updateValue('editor.minimap.enabled', false, ConfigurationTarget.MEMORY);
+				void this.configurationService.updateValue('editor.wordWrap', 'on', ConfigurationTarget.MEMORY);
+				void this.configurationService.updateValue('workbench.editor.showTabs', 'single', ConfigurationTarget.MEMORY);
+			} else {
+				void this.configurationService.updateValue('editor.minimap.enabled', undefined, ConfigurationTarget.MEMORY);
+				void this.configurationService.updateValue('editor.wordWrap', undefined, ConfigurationTarget.MEMORY);
+				void this.configurationService.updateValue('workbench.editor.showTabs', undefined, ConfigurationTarget.MEMORY);
+				setDrawerHidden(this.layoutService, false);
+			}
+		}
+
+		this.syncDrawerButton();
+	}
+
+	private syncDrawerButton(): void {
+		if (!this.compact) {
+			this.drawerButton?.remove();
+			this.drawerButton = undefined;
+			return;
+		}
+
+		if (!this.drawerButton) {
+			const button = document.createElement('button');
+			button.type = 'button';
+			button.className = 'dlx-drawer-toggle';
+			button.setAttribute('aria-label', localize('droidlabx.drawer', 'Menu'));
+			const icon = document.createElement('span');
+			icon.className = ThemeIcon.asClassName(Codicon.menu);
+			icon.setAttribute('aria-hidden', 'true');
+			button.appendChild(icon);
+			button.addEventListener('click', (e) => {
+				e.preventDefault();
+				e.stopPropagation();
+				setDrawerHidden(this.layoutService, this.layoutService.isVisible(Parts.SIDEBAR_PART));
+				this.syncDrawerButton();
+			});
+			this.drawerButton = button;
+		}
+
+		this.drawerButton.setAttribute('aria-expanded', String(this.layoutService.isVisible(Parts.SIDEBAR_PART)));
+		if (this.drawerButton.parentElement !== this.layoutService.mainContainer) {
+			this.layoutService.mainContainer.appendChild(this.drawerButton);
+		}
+	}
+}
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: TOGGLE_DRAWER_ID,
+			title: localize2('droidlabx.toggleDrawer', 'Menu'),
+			icon: Codicon.menu,
+			f1: true,
+			precondition: DroidLabXCompactContext,
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		const layoutService = accessor.get(IWorkbenchLayoutService);
+		setDrawerHidden(layoutService, layoutService.isVisible(Parts.SIDEBAR_PART));
+	}
+});
+
+registerWorkbenchContribution2(DroidLabXShellContribution.ID, DroidLabXShellContribution, WorkbenchPhase.AfterRestored);
